<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/keyboard_bg"
    android:padding="4dp">

    <!-- Preview trake: pokazuje / najavljuje trenutno slovo dok se kroz njega ciklira -->
    <TextView
        android:id="@+id/previewText"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center"
        android:textColor="@color/key_text"
        android:textSize="18sp"
        android:importantForAccessibility="no" />

    <!-- Kontrolni red 1: Enter (iznad 1), Brisanje (iznad 2), Glasovni unos (iznad 3) -->
    <LinearLayout
        android:id="@+id/controlRow1"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/keyEnter"
            style="@style/KeyButtonSpecial"
            android:text="⏎" />

        <Button
            android:id="@+id/keyBackspace"
            style="@style/KeyButtonSpecial"
            android:text="⌫" />

        <Button
            android:id="@+id/keyVoice"
            style="@style/KeyButtonSpecial"
            android:text="🎤" />
    </LinearLayout>

    <!-- Kontrolni red 2: Emotikoni, Podešavanja - oba traže dupli-dodir -->
    <LinearLayout
        android:id="@+id/controlRow2"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/keyEmoji"
            style="@style/KeyButtonSpecial"
            android:text="😀" />

        <Button
            android:id="@+id/keySettings"
            style="@style/KeyButtonSpecial"
            android:text="⚙" />
    </LinearLayout>

    <!-- 3x4 tastatura -->
    <LinearLayout android:id="@+id/gridRow1" android:layout_width="match_parent" android:layout_height="112dp" android:orientation="horizontal">
        <Button android:id="@+id/key1" style="@style/KeyButtonMain" android:text="1" />
        <Button android:id="@+id/key2" style="@style/KeyButtonMain" android:text="2\nabc" />
        <Button android:id="@+id/key3" style="@style/KeyButtonMain" android:text="3\ndef" />
    </LinearLayout>

    <LinearLayout android:id="@+id/gridRow2" android:layout_width="match_parent" android:layout_height="112dp" android:orientation="horizontal">
        <Button android:id="@+id/key4" style="@style/KeyButtonMain" android:text="4\nghi" />
        <Button android:id="@+id/key5" style="@style/KeyButtonMain" android:text="5\njkl" />
        <Button android:id="@+id/key6" style="@style/KeyButtonMain" android:text="6\nmno" />
    </LinearLayout>

    <LinearLayout android:id="@+id/gridRow3" android:layout_width="match_parent" android:layout_height="112dp" android:orientation="horizontal">
        <Button android:id="@+id/key7" style="@style/KeyButtonMain" android:text="7\npqrs" />
        <Button android:id="@+id/key8" style="@style/KeyButtonMain" android:text="8\ntuv" />
        <Button android:id="@+id/key9" style="@style/KeyButtonMain" android:text="9\nwxyz" />
    </LinearLayout>

    <LinearLayout android:id="@+id/gridRow4" android:layout_width="match_parent" android:layout_height="112dp" android:orientation="horizontal">
        <Button android:id="@+id/keyStar" style="@style/KeyButtonMain" android:text="*\n123" />
        <Button android:id="@+id/key0" style="@style/KeyButtonMain" android:text="0\nrazmak" />
        <Button android:id="@+id/keyHash" style="@style/KeyButtonMain" android:text="#\n⇧" />
    </LinearLayout>

</LinearLayout>
