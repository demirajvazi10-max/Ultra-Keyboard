<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/keyboard_bg"
    android:padding="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_title"
        android:textColor="@color/key_text"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="6dp" />

    <Button
        android:id="@+id/btnSettingsBackTop"
        style="@style/KeyButtonSpecial"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="6dp"
        android:text="@string/settings_back" />

    <Button
        android:id="@+id/btnToggleScript"
        style="@style/KeyButtonSpecial"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="4dp" />

    <Button
        android:id="@+id/btnToggleFeedback"
        style="@style/KeyButtonSpecial"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="4dp" />

    <Button
        android:id="@+id/btnToggleTapMode"
        style="@style/KeyButtonSpecial"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="4dp" />

    <Button
        android:id="@+id/btnToggleSize"
        style="@style/KeyButtonSpecial"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="4dp" />

    <Button
        android:id="@+id/btnSendLog"
        style="@style/KeyButtonSpecial"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="4dp"
        android:text="@string/settings_send_log" />

    <Button
        android:id="@+id/btnHelp"
        style="@style/KeyButtonSpecial"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="4dp"
        android:text="@string/settings_help" />

    <Button
        android:id="@+id/btnAbout"
        style="@style/KeyButtonSpecial"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="4dp"
        android:text="@string/settings_about" />

    <Button
        android:id="@+id/btnSettingsBack"
        style="@style/KeyButtonSpecial"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="@string/settings_back" />

</LinearLayout>
