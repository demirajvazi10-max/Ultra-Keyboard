<resources>
    <style name="KeyButtonMain">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:background">@drawable/key_background</item>
        <item name="android:textColor">@color/key_text</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="KeyButtonSpecial" parent="KeyButtonMain">
        <item name="android:background">@drawable/key_background</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="KeyButtonEmoji" parent="KeyButtonMain">
        <item name="android:textSize">22sp</item>
    </style>
</resources>
